generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AniKuoshi data models.
//
// These models are mirrored 1:1 by the MongoDB driver in
// src/lib/store/mongo.ts (used when MONGODB_URI is set — e.g. on Vercel with
// MongoDB Atlas). The store layer in src/lib/store/index.ts picks the driver
// at runtime so both worlds share one interface.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String? // data-URL (client-resized) or null -> initial letter
  preferences  String   @default("{}") // JSON blob: theme, accent, titleLang, defaultServer, ...
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress WatchProgress[]
  listItems UserListEntry[]
}

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  animeKey        String // canonical API key (anilist:<id> or title slug)
  animeTitle      String
  poster          String?
  episode         Int
  positionSeconds Float
  durationSeconds Float
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeKey])
  @@index([userId, updatedAt])
}

model UserListEntry {
  id        String   @id @default(cuid())
  userId    String
  animeKey  String
  animeTitle String
  poster    String?
  status    String   @default("watching") // watching | planning | completed | on-hold | dropped
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeKey])
  @@index([userId, status])
}
