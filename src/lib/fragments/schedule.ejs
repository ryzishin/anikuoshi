<%# AniKuoshi EJS fragment: today's release schedule (consumed by htmx swap) %>
<ul class="divide-y divide-border/60" role="list">
  <% entries.forEach(function (e) { %>
  <li class="flex items-center gap-3 py-2.5">
    <span class="w-12 shrink-0 rounded-md bg-muted px-1.5 py-1 text-center text-[11px] font-semibold tabular-nums text-muted-foreground">
      <%= e.time || '—' %>
    </span>
    <a
      class="min-w-0 flex-1 truncate text-[13px] font-medium hover:text-foreground text-foreground/85"
      href="/anime/<%= encodeURIComponent(e.navKey || String(e.slug || '').replace(/\/ep-\d+.*$/i, '') || e.title) %>"
    >
      <%= e.title %>
    </a>
    <% if (e.episode_no) { %>
    <span class="shrink-0 rounded-full border border-border px-2 py-0.5 text-[10px] font-semibold text-muted-foreground">
      EP <%= e.episode_no %>
    </span>
    <% } %>
  </li>
  <% }); %>
</ul>
<% if (!entries.length) { %>
<p class="py-4 text-xs text-muted-foreground">No releases scheduled today.</p>
<% } %>
